# Local PostgreSQL used by Docker Compose. Replace this development password.
POSTGRES_USER=knowledge_agent
POSTGRES_PASSWORD=change-me-before-use
POSTGRES_DB=knowledge_agent
DATABASE_URL=postgresql://knowledge_agent:change-me-before-use@127.0.0.1:5433/knowledge_agent

# The Trussium runtime is managed separately from this application.
TRUSSIUM_URL=http://127.0.0.1:9000
TRUSSIUM_TIMEOUT_SECONDS=30
# Set this to a model enabled for embeddings by the configured Trussium runtime.
TRUSSIUM_EMBEDDING_MODEL=replace-with-runtime-embedding-model
# Set this only when using the ask command; the runtime must have chat enabled.
TRUSSIUM_CHAT_MODEL=replace-with-runtime-chat-model
# Leave blank when runtime authentication is disabled; otherwise supply via a local secret.
TRUSSIUM_API_KEY=

# Leave blank to keep the read-only MCP endpoint unavailable. When enabling it,
# generate a strong secret and configure the same value in the runtime adapter.
KNOWLEDGE_AGENT_TOOL_TOKEN=
