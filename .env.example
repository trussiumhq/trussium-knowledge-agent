# Local PostgreSQL used by Docker Compose. Replace this development password.
POSTGRES_USER=knowledge_agent
POSTGRES_PASSWORD=change-me-before-use
POSTGRES_DB=knowledge_agent
DATABASE_URL=postgresql://knowledge_agent:change-me-before-use@127.0.0.1:5433/knowledge_agent

# The Trussium runtime is managed separately from this application.
TRUSSIUM_URL=http://127.0.0.1:9000
TRUSSIUM_TIMEOUT_SECONDS=30
# Set this to a model enabled for embeddings by the configured Trussium runtime.
TRUSSIUM_EMBEDDING_MODEL=replace-with-runtime-embedding-model
# Set this only when using the ask command; the runtime must have chat enabled.
TRUSSIUM_CHAT_MODEL=replace-with-runtime-chat-model
# Leave blank when runtime authentication is disabled; otherwise supply via a local secret.
TRUSSIUM_API_KEY=

# Leave blank to keep the read-only MCP endpoint unavailable. When enabling it,
# generate a strong secret and configure the same value in the runtime adapter.
KNOWLEDGE_AGENT_TOOL_TOKEN=

# Set to one operator-selected local Markdown root to enable docs.audit_links.
# Leave blank to keep the audit tool unavailable. Caller arguments cannot
# override this path. This audit does not fetch URLs or write repository files.
KNOWLEDGE_AGENT_AUDIT_ROOT=

# Store this append-only lifecycle journal on durable storage outside PostgreSQL
# backups. Restore procedures must replay it before exposing a recovered DB.
KNOWLEDGE_AGENT_LIFECYCLE_LEDGER_PATH=/var/lib/knowledge-agent/source-lifecycle.jsonl

# Optional private GitHub indexing. Leave these empty unless a GitHub App has
# been installed on only the repositories selected for this Knowledge Agent.
KNOWLEDGE_AGENT_GITHUB_APP_ID=
KNOWLEDGE_AGENT_GITHUB_INSTALLATION_ID=
KNOWLEDGE_AGENT_GITHUB_PRIVATE_KEY_PATH=
# Schedule reconciliation more frequently than this authorization lease.
KNOWLEDGE_AGENT_GITHUB_AUTHORIZATION_LEASE_SECONDS=900
# Required only for the HTTPS /webhooks/github endpoint; inject from a secret manager.
KNOWLEDGE_AGENT_GITHUB_WEBHOOK_SECRET=
